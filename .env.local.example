# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored (via the `.env*` rule in .gitignore) — never commit it.

# ─── Clerk Authentication (Phase 2) ──────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Tell Clerk where our sign-in / sign-up pages live (must match our routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to land after a successful sign-in / sign-up when no `redirect_url`
# query param is present. These are the current Clerk env var names — the
# older `AFTER_SIGN_IN_URL` aliases still work but are deprecated.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── Database (Phase 3) ──────────────────────────────────────────
# Both URLs come from your Neon project's "Connection details" panel.
# DATABASE_URL is the *pooled* URL — has "-pooler" in the hostname, used by
# the app for normal queries (handles many concurrent serverless connections).
# DIRECT_URL is the *direct* URL — same Postgres, no pooler, used by Prisma
# CLI commands (db push / migrate) which need session-level features.
DATABASE_URL=postgresql://user:password@ep-XXX-pooler.region.aws.neon.tech/onform?sslmode=require
DIRECT_URL=postgresql://user:password@ep-XXX.region.aws.neon.tech/onform?sslmode=require

# ─── Email (Phase 3) ─────────────────────────────────────────────
# Get from https://resend.com → API Keys.
# Free tier sends from `onboarding@resend.dev` until a domain is verified.
RESEND_API_KEY=re_replace_me

# ─── Founding admin (Phase 3) ────────────────────────────────────
# Email that gets auto-promoted to ADMIN on first sign-in.
FOUNDING_ADMIN_EMAIL=e.a.mateli@gmail.com

# ─── Clerk webhook (Phase 3) ─────────────────────────────────────
# Set after we configure the webhook endpoint in the Clerk dashboard.
CLERK_WEBHOOK_SECRET=whsec_replace_me

# ─── Phase 4+ env vars will be added below as we go ──────────────
# GOOGLE_PROJECT_ID=onform-data-warehouse
# GOOGLE_APPLICATION_CREDENTIALS_JSON='{...}'
# DATA_STUDIO_DASHBOARD_URL=https://lookerstudio.google.com/...
